generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PaymentState {
  DRAFT
  POSTED
  PAID
  CANCELLED
}

model Student {
  id             Int               @id @default(autoincrement())
  admissionNo    String            @unique @db.VarChar(255)
  firstName      String @db.VarChar(255)
  lastName       String? @db.VarChar(255)
  dateOfBirth    DateTime?
  gender         String? @db.VarChar(255)
  phone          String? @db.VarChar(255)
  email          String? @db.VarChar(255)
  address        String? @db.Text
  guardianName   String? @db.VarChar(255)
  guardianPhone  String? @db.VarChar(255)
  className      String? @db.VarChar(255)
  section        String? @db.VarChar(255)
  classSectionId Int?
  classSection   ClassSection?     @relation(fields: [classSectionId], references: [id])
  active         Boolean           @default(true)
  fees           StudentFee[]
  feeRecords     FeeRecord[]
  payments       FeePayment[]
  createdAt      DateTime          @default(now())
  attendance     Attendance[]
  leaveRequests  LeaveRequest[]
  guardianLinks  StudentGuardian[]
}

model StudentFee {
  id        Int          @id @default(autoincrement())
  studentId Int
  feeType   String @db.VarChar(255)
  amount    Decimal      @db.Decimal(12, 2)
  dueDate   DateTime
  status    PaymentState @default(DRAFT)
  student   Student      @relation(fields: [studentId], references: [id])
}

model FeePayment {
  id          Int        @id @default(autoincrement())
  studentId   Int
  feeRecordId Int?
  amount      Decimal    @db.Decimal(12, 2)
  receiptNo   String     @unique @db.VarChar(255)
  paidAt      DateTime   @default(now())
  method      String @db.VarChar(255)
  student     Student    @relation(fields: [studentId], references: [id])
  feeRecord   FeeRecord? @relation(fields: [feeRecordId], references: [id])
}

model Employee {
  id            Int             @id @default(autoincrement())
  employeeNo    String          @unique @db.VarChar(255)
  firstName     String @db.VarChar(255)
  lastName      String? @db.VarChar(255)
  designation   String @db.VarChar(255)
  salary        Decimal         @db.Decimal(12, 2)
  active        Boolean         @default(true)
  email         String? @db.VarChar(255)
  phone         String? @db.VarChar(255)
  department    String          @default("Operations") @db.VarChar(255)
  payrolls      Payroll[]
  createdAt     DateTime        @default(now())
  leaveRequests EmployeeLeave[]
}

model Payroll {
  id          Int          @id @default(autoincrement())
  employeeId  Int
  period      String @db.VarChar(255)
  basicSalary Decimal      @db.Decimal(12, 2)
  allowances  Decimal      @db.Decimal(12, 2)
  deductions  Decimal      @db.Decimal(12, 2)
  netSalary   Decimal      @db.Decimal(12, 2)
  status      PaymentState @default(DRAFT)
  employee    Employee     @relation(fields: [employeeId], references: [id])
  expenses    Expense[]
}

model Expense {
  id          Int          @id @default(autoincrement())
  category    String @db.VarChar(255)
  description String @db.Text
  amount      Decimal      @db.Decimal(12, 2)
  expenseDate DateTime     @default(now())
  status      PaymentState @default(POSTED)
  payrollId   Int?
  payroll     Payroll?     @relation(fields: [payrollId], references: [id])
  purchaseId  Int?
  purchase    Purchase?    @relation(fields: [purchaseId], references: [id])
}

model InventoryItem {
  id           Int             @id @default(autoincrement())
  sku          String?         @unique @db.VarChar(255)
  name         String @db.VarChar(255)
  category     String? @db.VarChar(255)
  quantity     Decimal         @db.Decimal(12, 2)
  reorderLevel Decimal         @db.Decimal(12, 2)
  unitCost     Decimal         @db.Decimal(12, 2)
  productId    Int?            @unique
  product      Product?        @relation(fields: [productId], references: [id])
  movements    StockMovement[]
}

model FeeRecord {
  id          Int          @id @default(autoincrement())
  studentId   Int?
  studentName String @db.VarChar(255)
  admissionNo String @db.VarChar(255)
  feeType     String @db.VarChar(255)
  amount      Decimal      @db.Decimal(12, 2)
  dueDate     DateTime
  status      PaymentState @default(DRAFT)
  createdAt   DateTime     @default(now())
  student     Student?     @relation(fields: [studentId], references: [id])
  payments    FeePayment[]
}

model Sale {
  id           Int          @id @default(autoincrement())
  invoiceNo    String       @unique @db.VarChar(255)
  customerName String @db.VarChar(255)
  description  String @db.Text
  total        Decimal      @db.Decimal(12, 2)
  status       PaymentState @default(DRAFT)
  issueDate    DateTime     @default(now())
  category     String       @default("School service") @db.VarChar(255)
  productId    Int?
  quantity     Decimal      @default(1) @db.Decimal(12, 2)
  product      Product?     @relation(fields: [productId], references: [id])
  customerId   Int?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  taxRate      Decimal      @default(0) @db.Decimal(6, 2)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  dueDate      DateTime?
  lines        OrderLine[]
  payments     Payment[]
}

model Purchase {
  id           Int          @id @default(autoincrement())
  billNo       String       @unique @db.VarChar(255)
  supplierName String @db.VarChar(255)
  description  String @db.Text
  total        Decimal      @db.Decimal(12, 2)
  status       PaymentState @default(DRAFT)
  issueDate    DateTime     @default(now())
  category     String       @default("School supplies") @db.VarChar(255)
  productId    Int?
  quantity     Decimal      @default(1) @db.Decimal(12, 2)
  product      Product?     @relation(fields: [productId], references: [id])
  vendorId     Int?
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  expenses     Expense[]
  taxRate      Decimal      @default(0) @db.Decimal(6, 2)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  dueDate      DateTime?
  lines        OrderLine[]
  payments     Payment[]
}

model Product {
  id             Int              @id @default(autoincrement())
  sku            String           @unique @db.VarChar(255)
  name           String @db.VarChar(255)
  category       String @db.VarChar(255)
  salePrice      Decimal          @db.Decimal(12, 2)
  purchasePrice  Decimal          @db.Decimal(12, 2)
  active         Boolean          @default(true)
  categoryId     Int?
  categoryRecord ProductCategory? @relation(fields: [categoryId], references: [id])
  inventory      InventoryItem[]
  purchases      Purchase[]
  sales          Sale[]
  orderLines     OrderLine[]
}

model OrderLine {
  id        Int      @id @default(autoincrement())
  saleId    Int?
  purchaseId Int?
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
  sale      Sale? @relation(fields: [saleId], references: [id], onDelete: Cascade)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id         Int @id @default(autoincrement())
  reference  String @unique @db.VarChar(255)
  saleId     Int?
  purchaseId Int?
  amount     Decimal @db.Decimal(12, 2)
  method     String @db.VarChar(255)
  paidAt     DateTime @default(now())
  sale       Sale? @relation(fields: [saleId], references: [id])
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
}

model User {
  id           Int @id @default(autoincrement())
  name         String @db.VarChar(255)
  email        String @unique @db.VarChar(255)
  passwordHash String @db.VarChar(255)
  role         String @default("EMPLOYEE") @db.VarChar(255)
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  sessions     Session[]
}

model Session {
  id        String @id @db.VarChar(255)
  userId    Int
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceSetting {
  id       Int @id @default(1)
  name     String @default("Meridian Studio") @db.VarChar(255)
  currency String @default("PKR") @db.VarChar(255)
  email    String @default("hello@example.com") @db.VarChar(255)
  address  String @default("") @db.Text
  timezone String @default("Asia/Karachi") @db.VarChar(255)
}

model ContactMessage {
  id        Int @id @default(autoincrement())
  name      String @db.VarChar(255)
  email     String @db.VarChar(255)
  subject   String @db.VarChar(255)
  message   String @db.Text
  status    String @default("NEW") @db.VarChar(255)
  source    String @default("CONTACT") @db.VarChar(255)
  createdAt DateTime @default(now())
  notification EmailNotification?
}

model EmailNotification {
  id               String @id @default(uuid()) @db.VarChar(255)
  contactMessageId Int @unique
  status           String @default("PENDING") @db.VarChar(255)
  attempts         Int @default(0)
  attemptedAt      DateTime?
  sentAt           DateTime?
  providerId       String? @db.VarChar(255)
  lastError        String? @db.VarChar(255)
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int @id @default(autoincrement())
  userId    Int?
  actor     String @db.VarChar(255)
  action    String @db.VarChar(255)
  entity    String @db.VarChar(255)
  recordId  String @db.VarChar(255)
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String @id @db.VarChar(255)
  userId    Int?
  createdAt DateTime @default(now())
  messages  ChatMessage[]
  actions   ChatAction[]
}

model ChatMessage {
  id        Int @id @default(autoincrement())
  sessionId String @db.VarChar(255)
  role      String @db.VarChar(255)
  content   String @db.Text
  createdAt DateTime @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ChatAction {
  id        String @id @db.VarChar(255)
  sessionId String @db.VarChar(255)
  name      String @db.VarChar(255)
  args      Json
  status    String @default("PENDING") @db.VarChar(255)
  expiresAt DateTime
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model RateLimitBucket {
  id        String @id @db.VarChar(255)
  count     Int
  resetAt   DateTime
  @@index([resetAt])
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(255)
  description String? @db.Text
  active      Boolean   @default(true)
  products    Product[]
}

model StockMovement {
  id              Int           @id @default(autoincrement())
  inventoryItemId Int
  movementDate    DateTime      @default(now())
  movementType    String @db.VarChar(255)
  quantity        Decimal       @db.Decimal(12, 2)
  reference       String? @db.VarChar(255)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model Attendance {
  id             Int      @id @default(autoincrement())
  studentId      Int
  attendanceDate DateTime
  status         String @db.VarChar(255)
  note           String? @db.Text
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, attendanceDate])
}

model LeaveRequest {
  id        Int      @id @default(autoincrement())
  studentId Int
  fromDate  DateTime
  toDate    DateTime
  reason    String @db.Text
  status    String   @default("PENDING") @db.VarChar(255)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model EmployeeLeave {
  id         Int      @id @default(autoincrement())
  employeeId Int
  fromDate   DateTime
  toDate     DateTime
  leaveType  String @db.VarChar(255)
  reason     String? @db.Text
  status     String   @default("PENDING") @db.VarChar(255)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Vendor {
  id        Int        @id @default(autoincrement())
  name      String @db.VarChar(255)
  phone     String? @db.VarChar(255)
  email     String? @db.VarChar(255)
  address   String? @db.Text
  active    Boolean    @default(true)
  purchases Purchase[]
}

model Customer {
  id      Int     @id @default(autoincrement())
  name    String @db.VarChar(255)
  phone   String? @db.VarChar(255)
  email   String? @db.VarChar(255)
  address String? @db.Text
  active  Boolean @default(true)
  sales   Sale[]
}

model ClassSection {
  id        Int       @id @default(autoincrement())
  className String @db.VarChar(255)
  section   String @db.VarChar(255)
  capacity  Int       @default(30)
  active    Boolean   @default(true)
  students  Student[]

  @@unique([className, section])
}

model Guardian {
  id           Int               @id @default(autoincrement())
  name         String @db.VarChar(255)
  relationship String? @db.VarChar(255)
  phone        String? @db.VarChar(255)
  email        String? @db.VarChar(255)
  address      String? @db.Text
  students     StudentGuardian[]
}

model StudentGuardian {
  studentId  Int
  guardianId Int
  isPrimary  Boolean  @default(false)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(255)
  name            String @db.VarChar(255)
  type            AccountType
  active          Boolean          @default(true)
  debitLines      JournalLine[]    @relation("DebitAccount")
  creditLines     JournalLine[]    @relation("CreditAccount")
  openingBalances OpeningBalance[]
}

model JournalEntry {
  id        Int           @id @default(autoincrement())
  number    String        @unique @db.VarChar(255)
  entryDate DateTime      @default(now())
  memo      String? @db.Text
  source    String? @db.VarChar(255)
  lines     JournalLine[]
}

model JournalLine {
  id              Int          @id @default(autoincrement())
  journalEntryId  Int
  debitAccountId  Int?
  creditAccountId Int?
  debit           Decimal      @db.Decimal(14, 2)
  credit          Decimal      @db.Decimal(14, 2)
  description     String? @db.Text
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  debitAccount    Account?     @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount   Account?     @relation("CreditAccount", fields: [creditAccountId], references: [id])
}

model OpeningBalance {
  id        Int      @id @default(autoincrement())
  accountId Int
  amount    Decimal  @db.Decimal(14, 2)
  side      String @db.VarChar(255)
  asOf      DateTime @default(now())
  note      String? @db.Text
  account   Account  @relation(fields: [accountId], references: [id])
}

model BankAccount {
  id             Int               @id @default(autoincrement())
  name           String @db.VarChar(255)
  accountNumber  String? @db.VarChar(255)
  openingBalance Decimal           @default(0) @db.Decimal(14, 2)
  active         Boolean           @default(true)
  transactions   BankTransaction[]
}

model BankTransaction {
  id              Int         @id @default(autoincrement())
  bankAccountId   Int
  transactionDate DateTime    @default(now())
  description     String @db.Text
  amount          Decimal     @db.Decimal(14, 2)
  direction       String @db.VarChar(255)
  reference       String? @db.VarChar(255)
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
}
