# Demo mode works without an external database or Gemini key.
DATABASE_MODE=demo
DEMO_DATABASE_URL=file:./demo.db
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/meridian
PORT=4000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
DEMO_MODE=true
# Required only when seeding a new non-demo workspace:
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Server only. Never prefix these with VITE_.
Gemini_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
BUSINESS_TIMEZONE=Asia/Karachi

# Hosted PostgreSQL: DATABASE_MODE=postgres, DATABASE_URL=postgresql://...
# For Vercel, set these in Project Settings > Environment Variables.
# Restrict mutations to your real domain; comma-separated extra preview origins are optional.
APP_ORIGINS=
TRUST_PROXY=
RATE_LIMIT_STORE=
# Email notifications (server only). Use either Resend or SMTP.
CONTACT_NOTIFICATION_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

